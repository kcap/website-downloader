{
  "evaluateHTML": false,
  "waitForDynamicContent": 4000,  
  "flattenAssets": true,
  "strippedAttributes": ["srcset", "integrity"],
  "disableStrippedAttributes": true,
  "strippedTags": ["iframe", "noscript", "*[id='exampleToStrip']"],
  "commentStrippedTags": true,
  "removeAllScripts": false,
  "combineAllStyles": false,
  "excludeScripts": [
    "gtag.js",
    "*gtm.js*",
    "*tagmanager*",
    "analytics.js",
    "cookiebot",
    "facebook.net",
    "*yandex.ru*",
    "*vk.com*"
  ],
  "ignoredSources": [
    "*fonts.googleapis.com*",
    "*fonts.gstatic.com*",
    "*youtube.com*"
  ],
  "embedScriptHead": "embed-head.js",
  "embedScriptBodyEnd": "embed-bodyend.js"
}