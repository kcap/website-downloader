{
    "evaluateHTML": true,
    "useViewports": [
    {
        "name": "Desktop",
        "width": 1280,
        "height": 800,
        "isMobile": false
    },
    {
        "name": "Tablet",
        "width": 768,
        "height": 1024,
        "isMobile": true,
        "hasTouch": true
    },
    {
        "name": "Mobile",
        "width": 375,
        "height": 812,
        "isMobile": true,
        "hasTouch": true
    }],
    "waitForDynamicContent": 4000,
    "flattenAssets": true,
    "strippedAttributes": ["srcset", "integrity"],
    "disableStrippedAttributes": true,
    "strippedTags": ["iframe", "noscript", "*[id='exampleToStrip']"],
    "commentStrippedTags": true,
    "removeAllScripts": false,
    "combineAllStyles": false,
    "excludeScripts": [
        "gtag.js",
        "*gtm.js*",
        "*tagmanager*",
        "analytics.js",
        "cookiebot",
        "facebook.net",
        "*yandex.ru*",
        "*vk.com*"
    ],
    "ignoredSources": [
        "*fonts.googleapis.com*",
        "*fonts.gstatic.com*",
        "*youtube.com*"
    ],
    "embedScriptHead": "embed-head.js",
    "embedScriptBodyEnd": "embed-bodyend.js"
}